rules_version = '2';

// Replace Deeds — Firestore Security Rules
//
// IMPORTANT: the app identifies the "owner" account by its login email, which is
// always "<username>@replacedeeds.app" (see usernameToEmail() in index.html). Since
// OWNER_USERNAME is set to "owner" in this app, that email is "owner@replacedeeds.app".
// If you ever rename OWNER_USERNAME, update the string below to match.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner() { return isSignedIn() && request.auth.token.email == 'owner@replacedeeds.app'; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }

    // ----- Full local-data backup (used to restore your data on a new device, and
    // by the Owner Dashboard's "View Full App" tool) -----
    match /users/{uid} {
      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      allow write: if isSelf(uid);
    }

    // ----- Usage analytics (only pushed if the user consents in-app) -----
    match /analytics/{uid} {
      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      allow write: if isSelf(uid);
    }

    // ----- Blocked-account flags -----
    // Only the owner can block/unblock. A user can check their own status (right
    // after login); the owner can check anyone's (Owner Dashboard).
    match /blocked/{uid} {
      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      allow write: if isOwner();
    }

    // ----- Location pings (owner-only visibility, for parental oversight) -----
    match /locations/{uid} {
      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      allow write: if isSelf(uid);
    }

    // ----- Family/approval directory (also powers chat search & contact lists) -----
    // Any signed-in user can read the whole list (needed to build their own contact
    // list with names/photos). Only the OWNER can create or change an entry — approving
    // someone is exclusively an owner action in this app.
    match /family_members/{uid} {
      allow get, list: if isSignedIn();
      allow write: if isOwner();
    }

    // ----- Public display profile (username/photo) for chat & contact lists -----
    match /profiles/{uid} {
      allow get, list: if isSignedIn();
      allow write: if isSelf(uid);
    }

    // ----- "Forgot Password" requests -----
    // Reachable from the login screen before signing in, so creation must be open to
    // everyone. No password is ever stored here — only the owner can read/resolve the
    // list, then verifies identity and shares a new password with the person directly.
    match /password_requests/{reqId} {
      allow create: if true;
      allow get, list, update: if isOwner();
    }

    // ----- Chat access requests (a non-approved user asking the owner to enable
    // messaging for them) -----
    match /chat_requests/{uid} {
      allow get: if isSelf(uid) || isOwner();
      allow list: if isOwner();
      allow create, update: if isSelf(uid) || isOwner();
    }

    // ----- Per-user block lists -----
    // Readable by any signed-in user, since you need to check whether the OTHER person
    // in a chat has blocked you before you can message them.
    match /blocks/{uid} {
      allow read: if isSignedIn();
      allow write: if isSelf(uid);
    }

    // ----- Personal 1:1 chat -----
    // chatId is always the two participants' UIDs, sorted and joined with "_", so only
    // the two people in that conversation (or the owner) can ever derive or read it.
    match /messages/{chatId}/msgs/{msgId} {
      allow read: if isOwner()
        || (isSignedIn() && chatId.split('_')[0] == request.auth.uid)
        || (isSignedIn() && chatId.split('_')[1] == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      // needed so a message can be edited to {deleted:true, ...} by either participant
      allow update: if isOwner()
        || (isSignedIn() && chatId.split('_')[0] == request.auth.uid)
        || (isSignedIn() && chatId.split('_')[1] == request.auth.uid);
    }

    // ----- Legacy/global group chat (kept only for the Owner Dashboard's viewer) -----
    match /group_chat/{docId}/msgs/{msgId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
      allow update: if isOwner();
    }

    // ----- Custom groups -----
    // Only the group's creator (or the owner) can change membership — matches the
    // app's own "Manage Group" screen, which only shows those controls to them.
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isOwner());

      match /msgs/{msgId} {
        allow read: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          || isOwner()
        );
        allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
        // needed so any member can mark their own message "deleted"
        allow update: if isSignedIn() && (
          request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members
          || isOwner()
        );
      }
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
